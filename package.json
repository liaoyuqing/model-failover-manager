{
  "name": "model-failover-manager",
  "version": "2.24.3",
  "description": "DSH 插件：会话模型选择弹窗 + 路由分组 + 免费渠道推荐，模型彻底失败后自动切换到组内下一个可用模型",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dependencies": {
    "dsh-llm-error-retry": "github:liaoyuqing/dsh-llm-error-retry#5543c344e926edb1b3a7c9872af92934be897deb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaoyuqing/model-failover-manager.git"
  },
  "main": "./host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.mjs",
    "qoder-compress-shim.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "docs/preview-model-selection.png",
    "docs/preview-routing-groups.png",
    "docs/preview-dashboard.png",
    "docs/preview-failed-models.png",
    "docs/preview-error-retry.png",
    "docs/preview-free-channels.png",
    "docs/market.zh.md",
    "docs/market.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
