{
  "name": "model-failover-manager",
  "version": "2.9.5",
  "description": "DSH 插件：会话模型选择弹窗 + 路由分组，模型彻底失败后自动切换到组内下一个可用模型",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaoyuqing/model-failover-manager.git"
  },
  "main": "./host.v14.mjs",
  "exports": {
    ".": "./host.v14.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.v14.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "docs/preview-model-selection.png",
    "docs/preview-routing-groups.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
