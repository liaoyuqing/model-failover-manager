{
  "name": "model-failover-manager",
  "version": "2.27.1",
  "description": "模型选择弹窗＋路由分组：模型失败后自动换到组内下一个可用模型并继续本轮；免费渠道页签一键装 Our Free Model、CodeArts、WorkBuddy、Trae、Qoder、Providers Hub 六个插件，覆盖华为云 CodeArts、腾讯 CodeBuddy、有道 LobsterAI、TRAE、Cline、MiniMax、智谱 ZCode、Gemini、Accio、讯飞 AStudio 等 23 个免费平台；另含数据看板与错误重试配置。",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dependencies": {
    "dsh-llm-error-retry": "github:liaoyuqing/dsh-llm-error-retry#5543c344e926edb1b3a7c9872af92934be897deb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaoyuqing/model-failover-manager.git"
  },
  "main": "./host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.mjs",
    "provider-prefix.mjs",
    "qoder-compress-shim.mjs",
    "trae-compress-shim.mjs",
    "codearts-resign-bridge.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "docs/preview-model-selection.png",
    "docs/preview-routing-groups.png",
    "docs/preview-dashboard.png",
    "docs/preview-failed-models.png",
    "docs/preview-error-retry.png",
    "docs/preview-free-channels.png",
    "docs/market.zh.md",
    "docs/market.en.md",
    "screenshots.json",
    "assets/icon-180.png",
    "assets/icon-512.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
